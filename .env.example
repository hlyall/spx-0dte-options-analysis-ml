# Copy to .env locally. Never commit actual credentials.
PORT=8787
HOST=127.0.0.1

# Optional entitled terminal connection; leave unset for public defaults.
# THETA_BASE_URL=http://127.0.0.1:25503/v3

# Optional Tradier market-data token. Sandbox is delayed and limited.
# TRADIER_TOKEN=
# TRADIER_SANDBOX=true

# Optional archive/model locations relative to this project.
# SPX_ARCHIVE_DIR=data/downloads
# SPX_MODEL_DIR=models

# Optional private provider configuration.
# SPX_FEED_CONFIG=config/providers.json
